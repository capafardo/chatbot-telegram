# ==============================================================================
# Configurações do Chatbot Educacional (CETAM / IBC)
# Copie este arquivo para .env e preencha suas configurações reais:
# cp .env.example .env
# ==============================================================================

# 1. Chave de API do Bot no Telegram (obtida com o @BotFather)
TELEGRAM_API_KEY=sua_chave_aqui_exemplo_123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# 2. Lista de IDs de Administradores no Telegram (separados por vírgula)
# Deixe vazio para permitir que qualquer estudante converse e consulte /metricas,
# mantendo o comando de curadoria (/regenerar) restrito ao terminal local.
# Quando preenchido, apenas os IDs desta lista poderão acionar /regenerar via Telegram.
# Para descobrir seu ID de usuário, fale com o bot @userinfobot no Telegram.
TELEGRAM_WHITELIST=

# 3. Limiar Mínimo de Confiança para a Classificação (de 0.0 a 1.0)
# Se a maior probabilidade predita for menor que este valor, aciona o Fallback.
# Padrão recomendado: 0.35
CONFIDENCE_THRESHOLD=0.35

# 4. Salt secreto para Anonimização LGPD (usado no cálculo de hash SHA-256 dos IDs)
# Recomenda-se alterar para uma sequência aleatória própria em produção.
SALT_ANONYMIZATION=cetam_ibc_pln_2026_salt_seguro

# 5. Modo de Operação do Modelo de Aprendizado de Máquina
# Opções: LogisticRegression (padrão recomendado) ou MultinomialNB
DEFAULT_ML_MODEL=LogisticRegression

# 6. Uso de Stemming (Radicalização) na Vetorização TF-IDF
# Opções: false (padrão recomendado - exibe no /debug de forma demonstrativa) ou true
USE_STEMMING=false

# 7. Caminho customizado para o dataset de intenções (opcional)
# Permite que o aluno troque o tema/personalidade do bot apontando para outro JSON:
# DATASET_PATH=data/intencoes.json

# 8. Nível de Log do Sistema (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
